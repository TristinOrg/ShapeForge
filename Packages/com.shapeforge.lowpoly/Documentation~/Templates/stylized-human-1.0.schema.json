{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/ShapeForge/v0.1.0/Packages/com.shapeforge.lowpoly/Documentation~/Templates/stylized-human-1.0.schema.json",
  "title": "ShapeForge Low Poly Stylized Human 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "style", "overallScale", "proportions", "head", "hair"],
  "properties": {
    "schema": { "const": "shapeforge.lowpoly.stylized-human/1.0" },
    "name": { "type": "string", "minLength": 1 },
    "style": { "type": "string", "minLength": 1 },
    "overallScale": { "type": "number", "minimum": 0.5, "maximum": 2 },
    "proportions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headScale", "shoulderWidth", "bodyWidth", "legLength"],
      "properties": {
        "headScale": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "shoulderWidth": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "bodyWidth": { "type": "number", "minimum": 0.7, "maximum": 1.4 },
        "legLength": { "type": "number", "minimum": 0.7, "maximum": 1.4 }
      }
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "depth", "jawWidth"],
      "properties": {
        "width": { "type": "number", "minimum": 0.75, "maximum": 1.3 },
        "height": { "type": "number", "minimum": 0.75, "maximum": 1.3 },
        "depth": { "type": "number", "minimum": 0.75, "maximum": 1.3 },
        "jawWidth": { "type": "number", "minimum": 0.7, "maximum": 1.25 }
      }
    },
    "face": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyeScale", "eyeSpacing", "eyeOpenness", "mouthWidth"],
      "properties": {
        "eyeScale": { "type": "number", "minimum": 0.6, "maximum": 1.5 },
        "eyeSpacing": { "type": "number", "minimum": 0.7, "maximum": 1.3 },
        "eyeOpenness": { "type": "number", "minimum": 0.35, "maximum": 1.4 },
        "mouthWidth": { "type": "number", "minimum": 0.5, "maximum": 1.5 }
      }
    },
    "hair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volume", "parting", "fringeLength", "sideburnLength", "spikeLength", "backSpikeVolume"],
      "properties": {
        "volume": { "type": "number", "minimum": 0.8, "maximum": 1.3 },
        "parting": { "type": "number", "minimum": 0.15, "maximum": 0.85 },
        "fringeLength": { "type": "number", "minimum": 0, "maximum": 1 },
        "sideburnLength": { "type": "number", "minimum": 0, "maximum": 1 },
        "spikeLength": { "type": "number", "minimum": 0.6, "maximum": 1.5 },
        "backSpikeVolume": { "type": "number", "minimum": 0.6, "maximum": 1.5 }
      }
    },
    "outfit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detailScale", "shortsVolume", "bootHeight"],
      "properties": {
        "detailScale": { "type": "number", "minimum": 0.6, "maximum": 1.5 },
        "shortsVolume": { "type": "number", "minimum": 0.75, "maximum": 1.35 },
        "bootHeight": { "type": "number", "minimum": 0.75, "maximum": 1.25 }
      }
    }
  }
}
