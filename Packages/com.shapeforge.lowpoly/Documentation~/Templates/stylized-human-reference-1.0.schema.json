{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeforge.dev/schemas/lowpoly/stylized-human-reference-1.0.schema.json",
  "title": "ShapeForge Low Poly Stylized Human Reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "front"],
  "properties": {
    "schema": {
      "const": "shapeforge.lowpoly.stylized-human-reference/1.0"
    },
    "front": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headWidth", "headHeight", "shoulderWidth", "bodyWidth", "legLength", "jawWidthToHeadWidth", "hairWidthToHeadWidth", "parting", "fringeLength", "sideburnLength"],
      "properties": {
        "headWidth": { "type": "number", "minimum": 0.18, "maximum": 0.312 },
        "headHeight": { "type": "number", "minimum": 0.195, "maximum": 0.338 },
        "shoulderWidth": { "type": "number", "minimum": 0.238, "maximum": 0.476 },
        "bodyWidth": { "type": "number", "minimum": 0.119, "maximum": 0.238 },
        "legLength": { "type": "number", "minimum": 0.343, "maximum": 0.686 },
        "jawWidthToHeadWidth": { "type": "number", "minimum": 0.546, "maximum": 0.975 },
        "hairWidthToHeadWidth": { "type": "number", "minimum": 0.92, "maximum": 1.495 },
        "parting": { "type": "number", "minimum": 0.15, "maximum": 0.85 },
        "fringeLength": { "type": "number", "minimum": 0, "maximum": 1 },
        "sideburnLength": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headDepth", "hairDepthToHeadDepth"],
      "properties": {
        "headDepth": { "type": "number", "minimum": 0.1575, "maximum": 0.273 },
        "hairDepthToHeadDepth": { "type": "number", "minimum": 0.864, "maximum": 1.404 }
      }
    }
  }
}
