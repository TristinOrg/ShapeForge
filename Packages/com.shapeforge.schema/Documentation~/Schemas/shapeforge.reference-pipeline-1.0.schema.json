{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeforge.dev/schemas/shapeforge.reference-pipeline-1.0.schema.json",
  "type": "object",
  "required": ["schema", "id", "status", "sourceImage", "artifacts", "remainingReviewKinds", "nextStage"],
  "properties": {
    "schema": { "const": "shapeforge.reference-pipeline/1.0" },
    "id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["awaiting-review", "ready-for-compiler"] },
    "sourceImage": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "object", "required": ["blueprint", "views", "reviewTemplate", "reviewedBlueprint"],
      "properties": {
        "blueprint": { "type": "string", "minLength": 1 },
        "views": { "type": "string", "minLength": 1 },
        "reviewTemplate": { "type": "string", "minLength": 1 },
        "reviewedBlueprint": { "type": ["string", "null"] }
      }, "additionalProperties": false
    },
    "remainingReviewKinds": { "type": "array", "items": { "type": "string" } },
    "nextStage": { "enum": ["human-or-ai-review", "category-compiler"] }
  }, "additionalProperties": false
}
