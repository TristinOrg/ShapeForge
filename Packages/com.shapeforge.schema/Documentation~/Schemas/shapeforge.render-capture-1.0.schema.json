{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/ShapeForge/v0.1.0/Packages/com.shapeforge.schema/Documentation~/Schemas/shapeforge.render-capture-1.0.schema.json",
  "title": "ShapeForge Render Capture 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "candidateId", "width", "height", "views"],
  "properties": {
    "schema": { "const": "shapeforge.render-capture/1.0" },
    "id": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 64, "maximum": 4096 },
    "height": { "type": "integer", "minimum": 64, "maximum": 4096 },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "azimuth", "elevation", "framingScale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "azimuth": { "type": "number", "minimum": -180, "maximum": 180 },
          "elevation": { "type": "number", "minimum": -89, "maximum": 89 },
          "framingScale": { "type": "number", "minimum": 1, "maximum": 3 }
        }
      }
    }
  }
}
