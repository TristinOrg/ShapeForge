{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/ShapeForge/v0.1.0/Packages/com.shapeforge.schema/Documentation~/Schemas/shapeforge.reconstruction-1.0.schema.json",
  "title": "ShapeForge Reconstruction Workflow 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "state", "iteration", "maximumIterations", "definition"],
  "properties": {
    "schema": { "const": "shapeforge.reconstruction/1.0" },
    "id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["draft", "referenceAssessed", "inventoryReady", "constructing", "comparing", "correcting", "qualityChecking", "completed", "failed"] },
    "iteration": { "type": "integer", "minimum": 0 },
    "maximumIterations": { "type": "integer", "minimum": 1, "maximum": 100 },
    "definition": { "$ref": "shapeforge.shape-1.0.schema.json" },
    "assessment": { "$ref": "shapeforge.reference-assessment-1.0.schema.json" },
    "inventory": { "$ref": "shapeforge.detail-inventory-1.0.schema.json" },
    "construction": { "$ref": "shapeforge.construction-plan-1.0.schema.json" },
    "comparison": { "$ref": "shapeforge.render-compare-1.0.schema.json" },
    "pendingPatch": { "$ref": "shapeforge.patch-1.0.schema.json" },
    "qualityPolicy": { "$ref": "shapeforge.quality-1.0.schema.json" }
  }
}
