{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/ShapeForge/v0.1.0/Packages/com.shapeforge.schema/Documentation~/Schemas/shapeforge.reference-1.0.schema.json",
  "title": "ShapeForge Multi-View Reference 1.0",
  "description": "Provider- and engine-independent semantic part observations from aligned reference views.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "parts"],
  "properties": {
    "schema": { "const": "shapeforge.reference/1.0" },
    "name": { "type": "string", "minLength": 1 },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/part" }
    }
  },
  "$defs": {
    "vector2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum", "confidence", "silhouette"],
      "properties": {
        "minimum": { "$ref": "#/$defs/vector2" },
        "maximum": { "$ref": "#/$defs/vector2" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "silhouette": {
          "type": "array",
          "items": { "$ref": "#/$defs/vector2" },
          "anyOf": [
            { "maxItems": 0 },
            { "minItems": 3 }
          ]
        }
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "anyOf": [
        { "required": ["front"] },
        { "required": ["side"] },
        { "required": ["back"] }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "front": { "$ref": "#/$defs/view" },
        "side": { "$ref": "#/$defs/view" },
        "back": { "$ref": "#/$defs/view" }
      }
    }
  }
}
