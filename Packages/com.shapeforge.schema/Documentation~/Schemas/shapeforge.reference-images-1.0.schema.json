{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/ShapeForge/v0.1.0/Packages/com.shapeforge.schema/Documentation~/Schemas/shapeforge.reference-images-1.0.schema.json",
  "title": "ShapeForge Reference Images 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "images"],
  "properties": {
    "schema": { "const": "shapeforge.reference-images/1.0" },
    "id": { "type": "string", "minLength": 1 },
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["viewId", "imagePath", "weight"],
        "properties": {
          "viewId": { "type": "string", "minLength": 1 },
          "imagePath": { "type": "string", "minLength": 1 },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
