{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/ShapeForge/v0.1.0/Packages/com.shapeforge.schema/Documentation~/Schemas/shapeforge.reference-assessment-1.0.schema.json",
  "title": "ShapeForge Reference Assessment 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "subject", "style", "cameraAzimuth", "cameraElevation", "detailLevel", "confidence", "visibleFeatures", "uncertainties"],
  "properties": {
    "schema": { "const": "shapeforge.reference-assessment/1.0" },
    "subject": { "type": "string", "minLength": 1 },
    "style": { "type": "string" },
    "cameraAzimuth": { "type": "number", "minimum": -180, "maximum": 180 },
    "cameraElevation": { "type": "number", "minimum": -90, "maximum": 90 },
    "detailLevel": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "visibleFeatures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "uncertainties": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
