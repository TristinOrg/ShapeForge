{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeforge.dev/schemas/shapeforge.reference-review-1.0.schema.json",
  "type": "object",
  "required": ["schema", "blueprintId", "decisions"],
  "properties": {
    "schema": { "const": "shapeforge.reference-review/1.0" },
    "blueprintId": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "required": ["kind", "value", "confidence", "source"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "value": {},
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "enum": ["human", "ai", "deterministic", "unresolved"] }
        }, "additionalProperties": false
      }
    }
  }, "additionalProperties": false
}
