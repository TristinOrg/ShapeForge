{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeforge.dev/schemas/shapeforge.reference-annotations-1.0.schema.json",
  "type": "object",
  "required": ["schema", "blueprintId"],
  "properties": {
    "schema": { "const": "shapeforge.reference-annotations/1.0" },
    "blueprintId": { "type": "string", "minLength": 1 },
    "palette": { "type": "array", "items": {
      "type": "object", "required": ["id", "hex"], "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "source": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }, "additionalProperties": false
    } },
    "measurements": { "type": "object", "additionalProperties": { "type": "number" } },
    "annotations": { "type": "array", "items": {
      "type": "object", "required": ["regionId", "text"], "properties": {
        "regionId": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "language": { "type": "string" }
      }, "additionalProperties": false
    } }
  }, "additionalProperties": false
}
