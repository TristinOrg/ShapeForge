{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/TristinOrg/ShapeForge/v0.1.0/Packages/com.shapeforge.schema/Documentation~/Schemas/shapeforge.render-compare-1.0.schema.json",
  "title": "ShapeForge Render Comparison 1.0",
  "description": "Provider-neutral normalized observations comparing reference and candidate renders.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "referenceId", "candidateId", "views", "discrepancies"],
  "properties": {
    "schema": { "const": "shapeforge.render-compare/1.0" },
    "referenceId": { "type": "string", "minLength": 1 },
    "candidateId": { "type": "string", "minLength": 1 },
    "views": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/view" } },
    "discrepancies": { "type": "array", "items": { "$ref": "#/$defs/discrepancy" } }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["silhouette", "proportion", "color", "detail"],
      "properties": {
        "silhouette": { "$ref": "#/$defs/score" },
        "proportion": { "$ref": "#/$defs/score" },
        "color": { "$ref": "#/$defs/score" },
        "detail": { "$ref": "#/$defs/score" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewId", "weight", "confidence", "scores"],
      "properties": {
        "viewId": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "confidence": { "$ref": "#/$defs/score" },
        "scores": { "$ref": "#/$defs/scores" }
      }
    },
    "discrepancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "viewId", "nodeId", "detailId", "severity", "message", "suggestedAction"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "viewId": { "type": "string" },
        "nodeId": { "type": "string" },
        "detailId": { "type": "string" },
        "severity": { "enum": ["information", "warning", "error"] },
        "message": { "type": "string", "minLength": 1 },
        "suggestedAction": { "type": "string" }
      }
    }
  }
}
