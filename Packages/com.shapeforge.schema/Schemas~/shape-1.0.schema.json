{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shapeforge.dev/schemas/shape-1.0.schema.json",
  "title": "ShapeForge Shape 1.0",
  "type": "object",
  "required": ["schema", "name", "style", "root"],
  "properties": {
    "schema": { "const": "shapeforge.shape/1.0" },
    "name": { "type": "string" },
    "style": { "type": "string" },
    "root": { "$ref": "#/$defs/node" }
  },
  "additionalProperties": false,
  "$defs": {
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      },
      "additionalProperties": false
    },
    "color": {
      "type": "object",
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "type": "number", "minimum": 0, "maximum": 1 },
        "g": { "type": "number", "minimum": 0, "maximum": 1 },
        "b": { "type": "number", "minimum": 0, "maximum": 1 },
        "a": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id", "name", "type", "transform", "appearance", "children"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "type": { "type": "string", "minLength": 1 },
        "transform": {
          "type": "object",
          "required": ["position", "eulerAngles", "scale"],
          "properties": {
            "position": { "$ref": "#/$defs/vector3" },
            "eulerAngles": { "$ref": "#/$defs/vector3" },
            "scale": { "$ref": "#/$defs/vector3" }
          },
          "additionalProperties": false
        },
        "appearance": {
          "type": "object",
          "required": ["colorRole", "hasColorOverride", "color"],
          "properties": {
            "colorRole": { "type": "string" },
            "hasColorOverride": { "type": "boolean" },
            "color": { "$ref": "#/$defs/color" }
          },
          "additionalProperties": false
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    }
  }
}
