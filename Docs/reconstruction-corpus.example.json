{
  "schema": "shapeforge.reconstruction-corpus/1.0",
  "id": "curated-reference-v1",
  "defaults": {
    "maxIterations": 8,
    "targetScore": 0.9,
    "minimumScore": 0.8,
    "minimumImprovement": 0.005
  },
  "cases": [
    {
      "id": "replace-with-case-id",
      "source": "../path/to/initial-shape.json",
      "reference": "../path/to/reference-images.json",
      "capture": "../path/to/render-capture.json"
    }
  ]
}
